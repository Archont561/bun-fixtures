{
  "extends": "./packages/config/base.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@": ["./packages/bun-fixture/src/plugin.ts"],
      "@/*": ["./packages/bun-fixture/*"],
      "@bun-fixture/config/*": ["./packages/config/*"],
      "@bun-fixture/std": ["./packages/std/src/index.ts"],
      "@bun-fixture/fast-check": ["./packages/fast-check/src/index.ts"],
      "@bun-fixture/dom": ["./packages/dom/src/index.ts"],
      "@bun-fixture/browser": ["./packages/browser/src/index.ts"],
      "@bun-fixture/vcr": ["./packages/vcr/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/*/test-plugins.ts",
    "apps/**/*"
  ]
}
