{
  "name": "bun-fixture",
  "version": "0.1.0",
  "description": "pytest-style scoped, injectable fixtures for `bun test` — autodiscovered per directory",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bun",
    "bun-test",
    "fixtures",
    "pytest",
    "conftest",
    "testing",
    "dependency-injection"
  ],
  "main": "./src/plugin.ts",
  "module": "./src/plugin.ts",
  "types": "./src/types.ts",
  "bin": {
    "bun-fixture": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./plugin": "./src/plugin.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test tests/fixtures.test.ts tests/nested",
    "test:bdd": "bun test tests/features.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@bun-fixture/config": "workspace:*"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/bun-fixture.git",
    "directory": "packages/bun-fixture"
  }
}
