{
  "name": "@archont561/bun-test-utils",
  "version": "0.1.0",
  "description": "pytest-style scoped, injectable fixtures for `bun test` \u2014 explicit test.extend() composition with describe, test, and expect as the public API",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Archont561 (https://github.com/Archont561)",
  "keywords": [
    "bun",
    "bun-test",
    "fixtures",
    "pytest",
    "testing",
    "dependency-injection",
    "test-utils"
  ],
  "homepage": "https://archont561.github.io/bun-test-utils/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archont561/bun-test-utils.git",
    "directory": "packages/bun-test-utils"
  },
  "bugs": {
    "url": "https://github.com/Archont561/bun-test-utils/issues"
  },
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./bdd": {
      "types": "./dist/bdd.d.ts",
      "import": "./dist/bdd.js",
      "default": "./dist/bdd.js"
    },
    "./snap": {
      "types": "./dist/snap.d.ts",
      "import": "./dist/snap.js",
      "default": "./dist/snap.js"
    },
    "./pbt": {
      "types": "./dist/pbt.d.ts",
      "import": "./dist/pbt.js",
      "default": "./dist/pbt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "bunup",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:bdd": "bun test e2e/bdd/features.test.ts",
    "test:e2e": "bun test e2e"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "smol-toml": "^1.9.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "happy-dom": ">=20.0.0",
    "fast-check": ">=4.0.0",
    "@aboviq/bun-test-cucumber": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    },
    "@aboviq/bun-test-cucumber": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@bun-test-utils/bdd": "workspace:*",
    "@bun-test-utils/browser": "workspace:*",
    "@bun-test-utils/config": "workspace:*",
    "@bun-test-utils/core": "workspace:*",
    "@bun-test-utils/dom": "workspace:*",
    "@bun-test-utils/pbt": "workspace:*",
    "@bun-test-utils/server": "workspace:*",
    "@bun-test-utils/snapshot": "workspace:*",
    "@bun-test-utils/std": "workspace:*",
    "@bun-test-utils/vcr": "workspace:*"
  },
  "bin": {
    "test-utils": "./dist/cli.js"
  }
}
