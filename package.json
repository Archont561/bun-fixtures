{
  "name": "bun-test-utils-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:bdd": "turbo run test:bdd",
    "test:e2e": "turbo run test:e2e",
    "test:all": "turbo run test test:e2e",
    "coverage": "turbo run build && bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage packages/*/tests packages/*/e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "turbo run dev",
    "docs:dev": "bun --filter docs dev",
    "docs:build": "bun --filter docs build",
    "docs:preview": "bun --filter docs preview",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "prepare": "lefthook install",
    "board": "backlog board",
    "status": "backlog status"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@biomejs/biome": "2.5.15",
    "@bun-test-utils/config": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "backlog": "^1.4.56",
    "bun-test-utils": "workspace:*",
    "bunup": "0.16.32",
    "lefthook": "^2.1.17",
    "skills": "^1.7.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
