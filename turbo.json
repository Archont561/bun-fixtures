{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "bun-test-utils#typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "bun-test-utils#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:bdd": {
      "dependsOn": ["bun-test-utils#build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["bun-test-utils#build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
